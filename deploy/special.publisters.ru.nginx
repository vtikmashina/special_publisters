server {
    listen 80;
    listen [::]:80;
    server_name special.publisters.ru 193.53.126.63 special-publisters.193.53.126.63.sslip.io;

    location ^~ /report/ {
        return 410;
    }

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name special.publisters.ru;

    location ^~ /report/ {
        return 410;
    }

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    ssl_certificate /etc/letsencrypt/live/special.publisters.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/special.publisters.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_ecdh_curve prime256v1:X25519:secp384r1;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
